# Factory starter kit — copy to .env and fill in real values.
# NOTHING in this file is a real credential. Every secret below is a placeholder.
# Never commit a filled-in .env.

# ---- App identity / branding (see config/theme.php) ----
APP_NAME="Factory App"
APP_TAGLINE="Built on the factory starter kit."
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_SLUG=factory-app
APP_LOGO=/images/logo.svg
THEME_PRIMARY=#1a56db
THEME_ACCENT=#0e9f6e
THEME_BACKGROUND=#ffffff
THEME_SURFACE=#f9fafb
THEME_TEXT=#111827
THEME_MUTED=#6b7280
THEME_FONT_SANS="'Liberation Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif"
THEME_FONT_DISPLAY="'Liberation Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif"

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ---- Shared database (iMac-hosted Postgres) ----
# SHARED_DB_ENABLED=true  -> app uses the shared iMac Postgres (DB_CONNECTION=pgsql).
# SHARED_DB_ENABLED=false -> app runs disconnected on local SQLite (dev / offline).
# The kit never installs or manages the database server; it only connects to it.
SHARED_DB_ENABLED=true
DB_CONNECTION=pgsql
DB_HOST=imac-db-host
DB_PORT=5432
DB_DATABASE=factory_shared
DB_USERNAME=factory_app
DB_PASSWORD=change-me
# DB_SCHEMA namespaces this app's tables inside the shared database.
# Use one unique schema per app, e.g. the app slug (app05, brain-shield, ...).
DB_SCHEMA=app_slug

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# ---- WorkOS AuthKit (sign-in) ----
# From the WorkOS dashboard (API Keys + Redirects). Free up to 1M monthly users.
# Redirect URL registered in WorkOS must match WORKOS_REDIRECT_URL exactly.
WORKOS_CLIENT_ID=client_your_client_id
WORKOS_API_KEY=<redacted>
WORKOS_REDIRECT_URL="${APP_URL}/authenticate"

# ---- Stripe billing (Laravel Cashier) ----
# From the Stripe dashboard. Use TEST keys (pk_test_ / sk_test_) until launch.
STRIPE_KEY=pk_test_your_publishable_key
STRIPE_SECRET=<redacted>
STRIPE_WEBHOOK_SECRET=<redacted>
CASHIER_CURRENCY=usd
# Stripe Price IDs for the app's plans. Create the products/prices in Stripe first.
STRIPE_PRICE_MONTHLY=price_your_monthly_price_id
STRIPE_PRICE_YEARLY=price_your_yearly_price_id

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Robert plans (Stripe Price IDs — create the products/prices in Stripe, then paste the IDs)
STRIPE_PRICE_BASIC=price_your_basic_id
STRIPE_PRICE_UNLIMITED=price_your_unlimited_id

# Scraper store the jobs:import command reads from
JOB_SCRAPER_DB_PATH=/home/hatch/workspace/your_files/job-scraper/jobs.db

# Digest admin allowlist (comma-separated emails allowed into /admin/subscribers)
ADMIN_EMAILS=dvaughnhouse@gmail.com,dvaughn@dvaughnhouse.com
